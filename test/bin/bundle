#!/usr/bin/env bash
set -euo pipefail
dir="${KAMAL_CLI_TEST_DIR:?}"
# registry logout: append its argv to logout-argv (argv keeps the deploy call).
# KAMAL_CLI_TEST_LOGOUT_FAIL=1 makes it fail. Its output carries registry text
# that kamal-cli must never print.
if [[ "${3:-} ${4:-}" == "registry logout" ]]; then
  printf '%s\n' "$@" >> "$dir/logout-argv"
  echo "  INFO [ab12cd34] Running /usr/bin/env docker logout ghcr.io on 104.131.24.46"
  echo "  INFO [ef56ab78] Running /usr/bin/env docker logout ghcr.io on 10.0.0.2"
  if [[ "${KAMAL_CLI_TEST_LOGOUT_FAIL:-}" == "1" ]]; then
    echo "ERROR (SSHKit::Command::Failed): Exception while executing on host 10.0.0.2: docker exit status: 1"
    echo "docker stderr: REGISTRY-SECRET-TEXT ghcr.io"
    exit 1
  fi
  echo "  INFO [ab12cd34] Finished in 0.3 seconds with exit status 0 (successful)."
  echo "Removing login credentials for ghcr.io REGISTRY-SECRET-TEXT"
  exit 0
fi
printf '%s\n' "$@" > "$dir/argv"
cat > "$dir/stdin"
if [[ -n "${KAMAL_CLI_TEST_LINES:-}" ]]; then
  for i in $(seq 1 "$KAMAL_CLI_TEST_LINES"); do echo "line $i"; done
fi
if [[ "${KAMAL_CLI_TEST_FAIL:-}" == "1" ]]; then
  echo "Launching interactive command with version abc on 10.0.0.1" >&2
  echo "boom" >&2
  exit 17
fi
if [[ -n "${KAMAL_CLI_TEST_LINES:-}" ]]; then
  exit 0
fi
echo "  INFO [deadbeef] Running docker ps on ${KAMAL_CLI_TEST_HOST:-10.0.0.1}"
echo "  INFO [deadbeef] Finished in 1.4 seconds with exit status 0 (successful)."
echo "Get current version of running container..."
echo "Launching interactive command with version abc via SSH from existing container on 10.0.0.1..."
echo "ok-stdout"
