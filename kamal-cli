#!/usr/bin/env ruby
# frozen_string_literal: true
# Run a local .rb through production `bin/rails runner` without quoting it
# through Kamal. File bytes go on stdin. No cp in v1.
# ponytail: stdin via argv-array system + Tempfiles; Open3.capture3 stdin_data hung on GBX ssh.

require "fileutils"
require "open3"
require "json"
require "tempfile"
require "tmpdir"

USAGE = <<~TEXT
  Usage:
    kamal-cli runner [-c CONFIG.yml] [-d DESTINATION] FILE.rb
    kamal-cli deploy|redeploy|rollback|setup|accessory [KAMAL ARGS...]

  Run from a Rails app cwd (needs config/deploy.yml).
  runner pipes FILE to:
    bundle exec kamal app exec [-c ...] [-d ...] --interactive --reuse -- bin/rails runner -
  Without -c it reads config/deploy.yml, which in some apps is staging: pass
  -c config/deploy.production.yml (or -d) to reach production. The result has
  the host it ran on; check it.
  deploy and redeploy run `bundle exec kamal deploy|redeploy ARGS` and save
  the whole log to a file. On success they print the last 30 lines and the
  log path. On failure they print the whole log. The exit code is Kamal's.
  rollback, setup and accessory (e.g. `accessory reboot NAME`) run the same way.

  Every deploy, redeploy, rollback and setup (ok or failed) writes one SOC 2
  deploy line with hq bin/soc2-event (app, command, result, commit, dirty
  tree, log name, seconds; approved-by = env KAMAL_APPROVAL_REF or "none")
  and keeps a copy of the log in ~/projects/hq/state/deploy-logs (0700, not
  committed). A failure there never changes the exit code.

  After every deploy, redeploy, rollback, setup or accessory command (ok or
  failed) it runs `kamal registry logout` (the hosts AND this Mac) with the
  same -d/-c flags, and prints one line: registry_logout status and host
  names. Security, Oct 29: no registry login may stay on a host or the Mac.
  Set KAMAL_CLI_REGISTRY_LOGOUT=0 to skip it (say why in the approval ref).
  A failed logout never changes the exit code. Apps on the law server
  (65.108.76.113) are skipped: "registry_logout: skipped (law)".

  deploy, redeploy and setup refuse to run when `git status --porcelain`
  shows any change or untracked file (Kamal would build and ship it, image
  tag _uncommitted_). Deploy from a clean worktree at a named commit.
  Override: KAMAL_CLI_ALLOW_DIRTY=1 (say why in KAMAL_APPROVAL_REF).
  Security, Oct 29, after a dirty-checkout Mailer deploy.
TEXT

DEPLOY_COMMANDS = %w[deploy redeploy rollback setup accessory].freeze
LOGOUT_COMMANDS = %w[deploy redeploy rollback setup accessory].freeze
LOGIN_FIRST_COMMANDS = %w[deploy redeploy rollback].freeze
LAW_HOSTS = %w[65.108.76.113].freeze
SOC2_EVENT = ENV["KAMAL_CLI_SOC2_EVENT"] || File.join(Dir.home, "projects/hq/bin/soc2-event")
KEEP_LOG_DIR = ENV["KAMAL_CLI_KEEP_LOG_DIR"] || File.join(Dir.home, "projects/hq/state/deploy-logs")

DEPLOY_TAIL = 30

CHATTER = [
  /\A\s*INFO /,
  /\AGet current version of running container/,
  /\ALaunching interactive command with version /
].freeze

def emit_ok(data)
  $stdout.puts JSON.generate({ "ok" => true, "data" => data })
  0
end

def emit_err(message, code)
  $stdout.puts JSON.generate({ "ok" => false, "error" => message, "code" => code })
  1
end

def strip_chatter(text)
  host = nil
  lines = text.to_s.lines
  while lines.any? && CHATTER.any? { |re| re.match?(lines.first) }
    if (match = lines.first.match(/ on (\S+?)\s*$/))
      host = match[1].sub(/\.+\z/, "")
    end
    lines.shift
  end
  [lines.join, host]
end

def runner(path, flags = [])
  unless File.file?("config/deploy.yml")
    return emit_err("run from a Rails app cwd (missing config/deploy.yml)", "NOT_RAILS_APP_CWD")
  end
  i = flags.index("-c") || flags.index("--config-file")
  config = i ? flags[i + 1] : flags.find { |f| f.start_with?("--config-file=") }&.split("=", 2)&.last
  return emit_err("config file not found: #{config}", "NOT_FOUND") if config && !File.file?(config)
  unless File.file?(path)
    return emit_err("file not found: #{path}", "NOT_FOUND")
  end

  out = Tempfile.new("kamal-cli-out")
  err = Tempfile.new("kamal-cli-err")
  begin
    bundle = ENV["KAMAL_CLI_BUNDLE"] || "bundle"
    File.open(path, "r") do |stdin_file|
      system(
        bundle, "exec", "kamal", "app", "exec", *flags,
        "--interactive", "--reuse", "--",
        "bin/rails", "runner", "-",
        in: stdin_file,
        out: out,
        err: err
      )
    end
    status = $?.nil? ? 1 : $?.exitstatus
    stdout, host = strip_chatter(File.read(out.path))
    stderr = File.read(err.path)
    data = { "exit" => status, "stdout" => stdout, "stderr" => stderr }
    data["host"] = host if host
    if status.zero?
      emit_ok(data)
    else
      msg = stdout.strip.empty? ? (stderr.strip.empty? ? "kamal runner failed" : stderr.strip) : stdout.strip
      emit_err(msg, "RUNNER_FAILED")
    end
  ensure
    out.close!
    err.close!
  end
end

def deploy(command, args)
  unless File.file?("config/deploy.yml")
    return emit_err("run from a Rails app cwd (missing config/deploy.yml)", "NOT_RAILS_APP_CWD")
  end
  refusal = gxbee_builder_refusal(args)
  return emit_err(refusal, "GXBEE_BUILDER_REFUSED") if refusal
  refusal = dirty_tree_refusal(command)
  return emit_err(refusal, "DIRTY_TREE") if refusal

  log_dir = File.join(Dir.tmpdir, "kamal-cli")
  FileUtils.mkdir_p(log_dir)
  stamp = Time.now.strftime("%Y%m%d-%H%M%S")
  log = File.join(log_dir, "#{File.basename(Dir.pwd)}-#{command}-#{stamp}.log")
  # Apps without a Gemfile (diagram) use the global kamal.
  kamal = File.file?("Gemfile") || ENV["KAMAL_CLI_BUNDLE"] ? [ENV["KAMAL_CLI_BUNDLE"] || "bundle", "exec", "kamal"] : ["kamal"]
  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  # deploy (with a remote builder), redeploy and rollback did not log in on Oct 29; every run now ends with a logout,
  # so log in first (Mac and hosts). setup and accessory boot log in themselves.
  # Never for law: Gov's packet logs in with the read-only token and logs out itself (Security, Oct 29).
  if LOGIN_FIRST_COMMANDS.include?(command) && ENV["KAMAL_CLI_REGISTRY_LOGOUT"] != "0" && !law_config?(args)
    # The login output carries registry text: it goes to a Tempfile that is never printed and is deleted.
    ok = Tempfile.create("kamal-cli-login") { |t| system(*kamal, "registry", "login", *config_flags(args), in: File::NULL, out: t, err: [:child, :out]) }
    unless ok
      File.write(log, "kamal-cli: registry login before #{command} failed (output not kept: registry text)\n")
      $stdout.puts "kamal-cli: registry login before #{command} FAILED; #{command} not run."
      record_deploy(command, 1, log, 0)
      return 1
    end
    system(*kamal, command, *args, in: File::NULL, out: log, err: [:child, :out])
  else
    system(*kamal, command, *args, in: File::NULL, out: log, err: [:child, :out])
  end
  status = $?.nil? ? 1 : $?.exitstatus
  seconds = (Process.clock_gettime(Process::CLOCK_MONOTONIC) - started).round
  lines = File.readlines(log)
  if status.zero?
    $stdout.print lines.last(DEPLOY_TAIL).join
    $stdout.puts "kamal-cli: #{command} ok (exit 0). Showing the last #{DEPLOY_TAIL} of #{lines.size} lines. Full log: #{log}"
  else
    $stdout.print lines.join
    $stdout.puts "kamal-cli: #{command} FAILED (exit #{status}). Full log: #{log}"
  end
  record_deploy(command, status, log, seconds)
  if LOGOUT_COMMANDS.include?(command) && ENV["KAMAL_CLI_REGISTRY_LOGOUT"] != "0"
    registry_logout(kamal, args, log)
  end
  status
end

# Security, Oct 28 (#4700): an app may build on gxbee only when it is ALLOWED in
# Cloud's builder-home/app-allowlist.md, and never a law app. Checked before
# kamal runs. Host names are compared exactly; an unreadable allowlist or deploy
# config fails closed. Returns nil when the deploy may go on.
GXBEE_BUILDER_HOSTS = %w[gxbee gxbee.tail478d01.ts.net].freeze
# The path is fixed; the override is read only in the test run (KAMAL_CLI_TEST_DIR set by test/run.sh).
GXBEE_ALLOWLIST = (ENV["KAMAL_CLI_TEST_DIR"] && ENV["KAMAL_CLI_GXBEE_ALLOWLIST"]) || File.join(Dir.home, "projects/cloud/builder-home/app-allowlist.md")

def gxbee_builder_refusal(args)
  texts = deploy_config_files(args).map { |f| File.read(f) }
  remotes = texts.flat_map { |t| t.scan(/^\s*remote:\s*["']?([^\s"'#]+)/).flatten }
  hosts = remotes.map { |r| r.sub(%r{\Assh://}, "").sub(/\A[^@]*@/, "").sub(/[:\/].*\z/, "") }
  docker_host = ENV["DOCKER_HOST"].to_s.sub(%r{\A\w+://}, "").sub(/\A[^@]*@/, "").sub(/[:\/].*\z/, "")
  return "gxbee builder refused: DOCKER_HOST names gxbee" if GXBEE_BUILDER_HOSTS.include?(docker_host)
  return nil unless hosts.any? { |h| GXBEE_BUILDER_HOSTS.include?(h) }
  return "gxbee builder refused: law app" if texts.any? { |t| LAW_HOSTS.any? { |h| t.include?(h) } } || LAW_HOSTS.any? { |h| args.join(" ").include?(h) }
  service = texts.first[/^service:\s*["']?([\w.-]+)/, 1]
  return "gxbee builder refused: no service name in config/deploy.yml" unless service
  allowed = File.readlines(GXBEE_ALLOWLIST).any? do |line|
    cells = line.split("|").map(&:strip)
    cells[1] == service && cells[4] == "ALLOWED"
  end
  allowed ? nil : "gxbee builder refused: #{service} is not ALLOWED in app-allowlist.md"
rescue StandardError => e
  "gxbee builder refused: check failed (#{e.class})"
end

# Security, Oct 29: a deploy from a dirty checkout shipped 3 unreviewed files (Mailer 2fc52a7_uncommitted).
# Commands that build an image refuse a tree with changes or untracked files. Outside a git repo: no check.
DIRTY_CHECK_COMMANDS = %w[deploy redeploy setup].freeze

def dirty_tree_refusal(command)
  return nil unless DIRTY_CHECK_COMMANDS.include?(command)
  return nil if ENV["KAMAL_CLI_ALLOW_DIRTY"] == "1"
  out, status = Open3.capture2("git", "status", "--porcelain", err: File::NULL)
  return nil unless status.success? && !out.strip.empty?
  "#{command} refused: the git tree has #{out.lines.size} changed or untracked path(s), and Kamal would ship them " \
    "(image tag _uncommitted_). Commit, or deploy from a clean worktree at a named commit. " \
    "Override: KAMAL_CLI_ALLOW_DIRTY=1 (say why in KAMAL_APPROVAL_REF)."
end

# config/deploy.yml plus the -c file and the -d destination file, when present.
def deploy_config_files(args)
  flags = config_flags(args)
  value = lambda do |short, long|
    i = flags.index(short) || flags.index(long)
    next flags[i + 1] if i
    flags.find { |f| f.start_with?("#{long}=") }&.split("=", 2)&.last ||
      flags.find { |f| f.start_with?(short) && f.size > 2 }&.slice(2..)
  end
  base = value.call("-c", "--config-file") || "config/deploy.yml"
  dest = value.call("-d", "--destination")
  files = ["config/deploy.yml", base]
  files << base.sub(/\.yml\z/, ".#{dest}.yml") if dest
  files.uniq.select { |f| File.file?(f) }
end

# Security, Oct 28: the deploy writes the registry password into each host's
# ~/.docker/config.json. After a good deploy the pull is done, so log the hosts
# out. Oct 29 (Security): on by default, after ok AND failed runs, and this Mac
# too (no -L): the next push logs in again by itself. Never changes the exit
# code, no retry, and only host names and ok/failed are printed (the output
# carries registry text).
def other_kamal_running?
  return ENV["KAMAL_CLI_TEST_OTHER_KAMAL"] == "1" if ENV.key?("KAMAL_CLI_TEST_OTHER_KAMAL")
  out, = Open3.capture2("ps", "-axo", "pid=,command=")
  out.each_line.any? do |l|
    pid, cmd = l.strip.split(" ", 2)
    pid.to_i != Process.pid && cmd.to_s.match?(%r{(^|/)kamal (deploy|redeploy|rollback|setup|build|accessory|app boot)\b})
  end
rescue StandardError
  true # unsure: keep the Mac login, log out the hosts only
end

def registry_logout(kamal, args, log)
  if law_deploy?(args, log)
    $stdout.puts "kamal-cli: registry_logout: skipped (law)"
    return
  end
  out = Tempfile.new("kamal-cli-logout")
  begin
    # Another Kamal run on this Mac may be pushing with the same Mac login: then log out the hosts only (-L),
    # or that push fails with "denied" (seen Oct 29 12:19). The last run to finish logs the Mac out.
    others = other_kamal_running?
    local = others ? ["-L"] : []
    system(*kamal, "registry", "logout", *local, *config_flags(args), in: File::NULL, out: out, err: [:child, :out])
    status = $?.nil? ? 1 : $?.exitstatus
    text = File.read(out.path)
  ensure
    out.close!
  end
  hosts = text.scan(/^\s*INFO \[\w+\] Running .* on ([\w.-]+?)\.*$/).flatten.uniq
  result = { "status" => status.zero? ? "ok" : "failed", "hosts" => hosts, "mac" => others ? "kept (another kamal running)" : "logged out" }
  unless status.zero?
    result["exit"] = status
    failed = text.scan(/executing on host ([\w.-]+?)\.*:/).flatten.uniq
    result["failed_hosts"] = failed if failed.any?
  end
  $stdout.puts "kamal-cli: registry_logout: #{JSON.generate(result)}"
rescue StandardError
  $stdout.puts "kamal-cli: registry_logout: #{JSON.generate({ 'status' => 'failed', 'hosts' => [] })}"
end

# The -d/--destination and -c/--config-file flags from the deploy args, so the
# logout reaches the same hosts.
def config_flags(args)
  flags = []
  args.each_with_index do |arg, i|
    case arg
    when "-d", "--destination", "-c", "--config-file"
      flags.push(arg, args[i + 1]) if args[i + 1]
    when /\A(-d|-c).+/, /\A--(destination|config-file)=/
      flags << arg
    end
  end
  flags
end

# Fails closed: the law IP in the args, the deploy config (base, destination
# or -c file) or the deploy log (Kamal names each host it ran on) means law.
def law_config?(args)
  dummy = Tempfile.new("kamal-cli-nolog")
  law_deploy?(args, dummy.path)
ensure
  dummy&.close!
end

def law_deploy?(args, log)
  flags = config_flags(args)
  value = lambda do |short, long|
    i = flags.index(short) || flags.index(long)
    next flags[i + 1] if i
    flags.find { |f| f.start_with?("#{long}=") }&.split("=", 2)&.last ||
      flags.find { |f| f.start_with?(short) && f.size > 2 }&.slice(2..)
  end
  base = value.call("-c", "--config-file") || "config/deploy.yml"
  dest = value.call("-d", "--destination")
  files = ["config/deploy.yml", base]
  files << base.sub(/\.yml\z/, ".#{dest}.yml") if dest
  texts = [args.join(" "), File.read(log)]
  texts += files.uniq.select { |f| File.file?(f) }.map { |f| File.read(f) }
  texts.any? { |t| LAW_HOSTS.any? { |h| t.include?(h) } }
rescue StandardError
  true
end

# Security, Oct 26: every deploy writes its own SOC 2 line, so no one records
# deploys from memory. Never changes the exit code.
def record_deploy(command, status, log, seconds)
  keep_log(log)
  # The Kamal service name (worktrees have other folder names); the folder name if there is none.
  service = File.foreach("config/deploy.yml").lazy.map { |l| l[/\Aservice:\s*["']?([\w.-]+)/, 1] }.find(&:itself) rescue nil
  app = service || File.basename(Dir.pwd)
  sha = IO.popen(["git", "rev-parse", "--short=8", "HEAD"], err: File::NULL, &:read).to_s.strip
  sha = "nogit" if sha.empty?
  dirty = IO.popen(["git", "status", "--porcelain"], err: File::NULL, &:read).to_s.strip.empty? ? "" : "+dirty"
  # Security, Oct 29: each use of the dirty-tree override is named in the line (the reason is the approval ref).
  dirty += " dirty-override" if !dirty.empty? && DIRTY_CHECK_COMMANDS.include?(command) && ENV["KAMAL_CLI_ALLOW_DIRTY"] == "1"
  result = status.zero? ? "ok" : "FAILED exit #{status}"
  ref = ENV["KAMAL_APPROVAL_REF"].to_s.strip
  ref = "none" if ref.empty?
  stamp = File.basename(log)[/(\d{8}-\d{6})\.log\z/, 1] || "unknown"
  summary = "#{command} #{result} commit #{sha}#{dirty} log #{stamp} #{seconds}s"
  out, st = Open3.capture2e(SOC2_EVENT, "add", "--kind", "deploy", "--system", app, "--summary", summary,
                            "--approved-by", ref, "--by", "kamal-cli")
  if st.success?
    $stdout.puts "kamal-cli: recorded deploy event"
  else
    # soc2-event's refusal is fixed text naming the field (for example a full 40-character SHA in
    # KAMAL_APPROVAL_REF); long runs are masked anyway.
    why = out.lines.map(&:strip).reject(&:empty?).last.to_s.gsub(/[A-Za-z0-9+\/_=-]{20,}/, "[long]")[0, 160]
    $stdout.puts "kamal-cli: event NOT recorded (soc2-event: #{why.empty? ? 'no reason given' : why})"
  end
rescue StandardError
  $stdout.puts "kamal-cli: event NOT recorded"
end

# A copy outside $TMPDIR (macOS cleans it). Runs first, so a git or event failure cannot skip it.
def keep_log(log)
  FileUtils.mkdir_p(KEEP_LOG_DIR, mode: 0o700)
  File.chmod(0o700, KEEP_LOG_DIR)
  kept = File.join(KEEP_LOG_DIR, File.basename(log))
  FileUtils.cp(log, kept)
  File.chmod(0o600, kept)
rescue StandardError
  $stdout.puts "kamal-cli: log copy NOT kept"
end

def main(argv)
  if argv.empty? || argv[0] == "-h" || argv[0] == "--help" || argv[0] == "help"
    $stdout.print USAGE
    return 0
  end
  return deploy(argv[0], argv[1..]) if DEPLOY_COMMANDS.include?(argv[0])
  args = argv[1..] || []
  flags = config_flags(args)
  rest = args - flags
  unless argv[0] == "runner" && rest.size == 1
    return emit_err("usage: kamal-cli runner [-c CONFIG.yml] [-d DESTINATION] FILE.rb", "USAGE")
  end
  runner(rest[0], flags)
end

exit(main(ARGV))
